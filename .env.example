# Knowledge Acquisition — settings (declared in ka/config.py; `python -m ka env` lists them)
ANTHROPIC_API_KEY=
KA_LLM_PROVIDER=            # anthropic | stub  (empty: anthropic if key set, else stub)
KA_LLM_MODEL=claude-sonnet-4-6
KA_LLM_MAX_TOKENS=4000
KA_LLM_TIMEOUT=120
KA_STORAGE_ROOT=            # default <repo>/ka_storage
KA_BACKEND_PORT=8011
KA_RESEARCH_INTERNET=0      # 1 lets the Internet Research Agent fetch URLs named in a mission
KA_AUTO_RESOLVE_AUTHORITY_GAP=40
KA_DUPLICATE_THRESHOLD=0.82
KA_RELATED_THRESHOLD=0.35
KA_PROMOTION_MIN_INSTANCES=3
KA_HIGH_IMPACT_INSTANCES=5
# access and network safety (plan-02)
KA_ACCESS_POLICY=token      # loopback | token | open — token: loopback passes, others need the bearer token
KA_ACCESS_TOKEN=            # required from non-loopback addresses when policy is token
KA_MAX_UPLOAD_MB=25
KA_URL_ALLOWLIST=           # comma-separated intranet hosts link()/research may fetch even if private
# enterprise-os integration (optional)
KA_ENTERPRISE_OS_ROOT=
KW_STORAGE_ROOT=
