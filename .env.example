# Knowledge Acquisition — settings (declared in ka/config.py; `python -m ka env` lists them)
ANTHROPIC_API_KEY=
KA_LLM_PROVIDER=            # anthropic | stub  (empty: anthropic if key set, else stub)
KA_LLM_MODEL=claude-sonnet-4-6
KA_LLM_MAX_TOKENS=4000
KA_LLM_TIMEOUT=120
KA_STORAGE_ROOT=            # default <repo>/ka_storage
KA_BACKEND_PORT=8011
KA_RESEARCH_INTERNET=0      # 1 lets the Internet Research Agent fetch URLs named in a mission
KA_AUTO_RESOLVE_AUTHORITY_GAP=40
KA_DUPLICATE_THRESHOLD=0.82
KA_RELATED_THRESHOLD=0.35
KA_PROMOTION_MIN_INSTANCES=3
KA_HIGH_IMPACT_INSTANCES=5
# access and network safety (plan-02)
KA_ACCESS_POLICY=token      # loopback | token | open — token: loopback passes, others need the bearer token
KA_ACCESS_TOKEN=            # required from non-loopback addresses when policy is token
KA_MAX_UPLOAD_MB=25
KA_URL_ALLOWLIST=           # comma-separated intranet hosts link()/research may fetch even if private
# discovery (plan-07; the real search provider is Q5)
KA_SEARCH_PROVIDER=none     # none | fixture | brave (plan-13; Q5)
KA_SEARCH_API_KEY=          # Brave Search API key, read at call time, never stored (Q12 — the author's)
KA_SEARCH_MONTHLY_CAP=1000  # queries per calendar month across all missions
KA_SEARCH_FIXTURE=          # JSON {query: [results]} for the fixture provider
KA_ALLOWED_DOMAINS=         # comma-separated hosts discovery may select; empty = any public host
KA_DISCOVERY_BUDGET=5
KA_DISCOVERY_RESULTS=10
KA_RESPECT_ROBOTS=1
# managed connectors (plan-08; providers beyond the local folder are Q6)
KA_CONNECTOR_ROOTS=         # comma-separated folders a local_folder connection may point into; default <storage>/inbox
# m365 connector (plan-14; the app registration is Q13): tenant/client/drive ids live on the connection; the client secret is read from the
# environment variable the connection names in secret_ref, e.g. M365_CLIENT_SECRET=...
KA_M365_PERMISSION_SWEEP_EVERY=10
# enterprise-os integration (optional)
KA_ENTERPRISE_OS_ROOT=
KW_STORAGE_ROOT=
